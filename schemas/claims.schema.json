{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "epistemic_status",
    "recorded_on",
    "summary",
    "source_ids",
    "inference",
    "supporting_claim_ids",
    "evidence_locators",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "epistemic_status": {
      "enum": [
        "PERSONAL RECOLLECTION",
        "DESIGN HYPOTHESIS",
        "EXTERNALLY VERIFIED FACT",
        "POLICY PROPOSAL",
        "SIMULATION RESULT",
        "ADOPTED PROJECT DECISION"
      ]
    },
    "recorded_on": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "inference": {
      "type": [
        "string",
        "null"
      ]
    },
    "supporting_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_locators": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "verification": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewer",
            "verified_on",
            "method"
          ],
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "verified_on": {
              "type": "string",
              "format": "date"
            },
            "method": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "epistemic_status": {
            "const": "EXTERNALLY VERIFIED FACT"
          }
        }
      },
      "then": {
        "properties": {
          "source_ids": {
            "minItems": 1
          },
          "evidence_locators": {
            "minItems": 1
          },
          "verification": {
            "type": "object"
          }
        }
      }
    }
  ]
}
